# SmartCampus ERP — environment template  (scope §62)
#
# Copy to `.env` and fill in the real values:
#     cp .env.example .env
#
# `.env` is git-ignored and MUST NEVER be committed. Every value below is either a
# safe local-development default or an obvious placeholder — none of them are real
# secrets. Anything marked CHANGE ME has to be supplied before that feature works.


# ---------------------------------------------------------------------------
# Database — MySQL 8.4, started by `docker compose up -d`.
# The credentials below match docker-compose.yml exactly and are dev-only.
# ---------------------------------------------------------------------------
DB_URL=jdbc:mysql://localhost:3306/smartcampus
DB_USERNAME=smartcampus
DB_PASSWORD=smartcampus

# Phases are built in parallel waves and each phase's migration owns a pre-assigned
# version number, so they do not always reach a shared dev database in ascending
# order. Set to false only against a database whose migrations were applied in order
# (e.g. a fresh clone/schema) — otherwise Flyway aborts startup with "Detected
# resolved migration not applied to database: N".
FLYWAY_OUT_OF_ORDER=true


# ---------------------------------------------------------------------------
# JWT — signing key and token lifetime for stateless authentication.
# JWT_SECRET must be a random string of at least 32 bytes (HS256 minimum).
# Generate one with:   openssl rand -base64 48
# Never reuse the placeholder, and never share the key between environments.
# JWT_EXPIRATION is in milliseconds (86400000 = 24 hours).
# ---------------------------------------------------------------------------
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48
JWT_EXPIRATION=86400000


# ---------------------------------------------------------------------------
# CORS — browser origins allowed to call the API (§61, §71).
# Comma-separated. The default covers both Vite dev ports: Vite falls forward to
# 5174 when 5173 is already in use by another project, and an origin missing from
# this list shows up in the browser as a CORS failure that looks like a broken
# backend rather than a port clash.
# In production, narrow this to the deployed frontend origin only.
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174


# ---------------------------------------------------------------------------
# AI — Groq, which speaks the OpenAI-compatible Chat Completions API.
# The key is read by the backend only and never reaches the browser (§25, §61).
# Get a key at https://console.groq.com/keys  (free tier is sufficient).
# AI_MODEL: leaving this blank is a supported mode — the backend resolves an
# available id against a live GET {AI_BASE_URL}/models call rather than a guess,
# since model ids are retired regularly.
# Switching provider (Gemini, OpenAI) is a change to these four values only.
# ---------------------------------------------------------------------------
AI_PROVIDER=groq
AI_API_KEY=place your key here
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=


# Phase 5 analytics (all optional; defaults in application.properties)
ANALYTICS_TREND_MONTHS=6
ANALYTICS_MAX_TREND_MONTHS=24
ANALYTICS_AT_RISK_LIST_LIMIT=20

# Phase 6 AI rate limiting (§61) — requests per caller in the trailing window.
AI_RATE_LIMIT_PER_MINUTE=5
AI_RATE_LIMIT_PER_DAY=100


# ---------------------------------------------------------------------------
# SMTP — OTP, password reset and notification mail.
# In development this points at Mailpit from docker-compose.yml, which accepts
# any credentials and delivers nothing onward. Read the captured mail at
# http://localhost:8025 . Mailpit needs no username or password, so both are
# left empty here; a real provider (SES, Mailgun, Gmail app password) fills them.
# ---------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=noreply@smartcampus.local


# ---------------------------------------------------------------------------
# Password reset OTP (Phase 2) — expiry and retry limits for the forgot-password
# flow. Defaults are safe for local development.
# ---------------------------------------------------------------------------
PASSWORD_RESET_OTP_EXPIRATION_MINUTES=15
PASSWORD_RESET_MAX_ATTEMPTS=5


# ---------------------------------------------------------------------------
# Attendance (Phase 4) — minimum attendance percentage before a student is
# warned (§18).
# ---------------------------------------------------------------------------
ATTENDANCE_MINIMUM_PERCENTAGE=75


# ---------------------------------------------------------------------------
# Judge0 — sandboxed code execution (Phase 7).
#
# Self-hosted (the default below) works on an amd64 Linux host with cgroup v1:
#     cp judge0.conf.example judge0.conf
#     docker compose --profile judge0 up -d
# and leave JUDGE0_API_KEY empty — a local instance requires no key.
#
# It does NOT work under Docker Desktop (Apple Silicon or Intel): the VM runs a
# cgroup v2-only kernel and Judge0's `isolate` sandbox requires cgroup v1, so every
# submission returns status 13 Internal Error. This was tested, not assumed —
# docs/judge0-notes.md has the transcript.
#
# Hosted fallback for local dev on this machine (RapidAPI):
#     JUDGE0_URL=https://judge0-ce.p.rapidapi.com
#     JUDGE0_API_KEY=<your RapidAPI key>
# from https://rapidapi.com/judge0-official/api/judge0-ce
# The backend reads both variables, so switching is config-only — no code change.
# ---------------------------------------------------------------------------
JUDGE0_URL=http://localhost:2358
JUDGE0_API_KEY=
# Only for RapidAPI — set to judge0-ce.p.rapidapi.com. Leave empty for a self-hosted instance.
JUDGE0_HOST_HEADER=


# Phase 11 real-time (both optional; the defaults are correct for development)
REALTIME_MAX_SESSIONS_PER_USER=5
NOTIFICATION_FANOUT_BATCH_SIZE=500
